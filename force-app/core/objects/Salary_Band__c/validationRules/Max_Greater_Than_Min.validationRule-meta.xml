<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Max_Greater_Than_Min</fullName>
    <active>true</active>
    <errorConditionFormula>Max_Salary__c &lt; Min_Salary__c</errorConditionFormula>
    <errorDisplayField>Max_Salary__c</errorDisplayField>
    <errorMessage>O salário máximo deve ser maior ou igual ao mínimo.</errorMessage>
</ValidationRule>
