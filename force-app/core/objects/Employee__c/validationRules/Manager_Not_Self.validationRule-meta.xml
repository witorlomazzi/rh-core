<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Manager_Not_Self</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(Manager__c)), NOT(ISBLANK(Id)), CASESAFEID(Manager__c) = CASESAFEID(Id))</errorConditionFormula>
    <errorDisplayField>Manager__c</errorDisplayField>
    <errorMessage>O colaborador não pode ser gestor de si mesmo.</errorMessage>
</ValidationRule>
