<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Termination_After_Hire</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(Termination_Date__c)), Termination_Date__c &lt; Hire_Date__c)</errorConditionFormula>
    <errorDisplayField>Termination_Date__c</errorDisplayField>
    <errorMessage>A data de desligamento deve ser igual ou posterior à data de admissão.</errorMessage>
</ValidationRule>
