<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Balance_Days__c</fullName>
    <description>Direito menos gozados, vendidos e pendentes.</description>
    <formula>BLANKVALUE(Entitled_Days__c, 0) - BLANKVALUE(Days_Taken__c, 0) - BLANKVALUE(Days_Sold__c, 0) - BLANKVALUE(Days_Pending__c, 0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Saldo de dias</label>
    <precision>4</precision>
    <scale>0</scale>
    <type>Number</type>
</CustomField>
